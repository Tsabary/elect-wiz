# Copy to .env.local for local overrides. All values are optional.

# Active content corpus: "real" (the default) or "placeholder" (fictional; the
# test runs select it themselves).
# CONTENT_CORPUS=real

# Time-based modes (absolute instants; defaults from research/legal-findings.md).
# Poll blackout: Fri 2026-10-23 12:00 Asia/Jerusalem (+03:00).
POLL_BLACKOUT_START=2026-10-23T09:00:00Z
# Polls close: Tue 2026-10-27 22:00 Asia/Jerusalem (+02:00).
ELECTION_CLOSE=2026-10-27T20:00:00Z

# Deployment environment when not on Vercel (Vercel sets VERCEL_ENV itself).
# Dev-only affordances (the clock override) are disabled in "production".
# APP_ENV=development

# Counter store for the anonymous daily counts (POST /api/tally): an Upstash
# Redis database, reached through its REST API. With either value unset the
# route checks each call and counts nothing (local development, tests).
# KV_REST_API_URL / KV_REST_API_TOKEN (set by the Vercel Marketplace) also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
