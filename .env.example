# Copy to .env.local for local overrides. All values are optional.

# Matching implementation behind POST /api/match. Phase 1: only "mock".
MATCHING_IMPL=mock
# Mock only: artificial latency (ms) so the loading state is visible.
MOCK_DELAY_MS=0

# Active content corpus: "placeholder" (fictional, default until Task 4.1) or "real".
CONTENT_CORPUS=placeholder

# Time-based modes (absolute instants; defaults from research/legal-findings.md).
# Poll blackout: Fri 2026-10-23 12:00 Asia/Jerusalem (+03:00).
POLL_BLACKOUT_START=2026-10-23T09:00:00Z
# Polls close: Tue 2026-10-27 22:00 Asia/Jerusalem (+02:00).
ELECTION_CLOSE=2026-10-27T20:00:00Z

# Deployment environment when not on Vercel (Vercel sets VERCEL_ENV itself).
# Dev-only affordances (mock scenario forcing) are disabled in "production".
# APP_ENV=development
